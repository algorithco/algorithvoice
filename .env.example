# ---- Algorith Voice root env template (never commit real .env) ----
NODE_ENV=development

# Backend
PORT=3001
API_URL=https://api.trqsh.uz
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://algorith:algorith@localhost:5432/algorith_voice?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-32-chars-minimum-access
JWT_REFRESH_PEPPER=change-me-32-chars-minimum-refresh
# Base64 of >= 32 bytes. Generate: openssl rand -base64 32
ENCRYPTION_KEK=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# OAuth (backend confidential client)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Stripe (backend only)
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_PRO=price_
STRIPE_PORTAL_CONFIG=

# STT providers (backend only, never ship to client)
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# Defaults shown; uncomment to override
# STT_PRIMARY=nvidia/parakeet-tdt-0.6b-v3
# STT_FALLBACK=openai/whisper-large-v3

# Object storage R2 (opt-in audio only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=algorith-voice-audio

# Web (Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=https://api.trqsh.uz
NEXT_PUBLIC_STRIPE_PRICE_PRO=price_
NEXT_PUBLIC_GITHUB_REPO=algorithco/algorithvoice-app
GITHUB_TOKEN=

# Desktop updater
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
