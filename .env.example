# ---- Algorith Voice root env template (never commit real .env) ----
NODE_ENV=development
POSTGRES_PASSWORD=dev-only-change-me-postgres
REDIS_PASSWORD=dev-only-change-me-redis

# Backend
PORT=3001
API_URL=http://localhost:3001
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://algorith:dev-only-change-me-postgres@localhost:5432/algorith_voice?schema=public
REDIS_URL=redis://:dev-only-change-me-redis@localhost:6379
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-32chars
JWT_REFRESH_PEPPER=dev-only-change-me-refresh-pepper-32chars
AUDIT_HASH_KEY=
# Reserved for a future encrypted backend BYOK vault; currently unused.
ENCRYPTION_KEK=

# OAuth (backend confidential client)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
# Temporary compatibility for released desktop builds. New builds use OAuth2 PKCE.
LEGACY_DESKTOP_OAUTH_TOKEN_IN_URL=true
TRUST_PROXY_HOPS=0
READINESS_TOKEN=

# Stripe (backend only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PORTAL_CONFIG=

# STT providers (backend only, never ship to client)
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
# Defaults shown; uncomment to override
# STT_PRIMARY=nvidia/parakeet-tdt-0.6b-v3
# STT_FALLBACK=openai/whisper-large-v3
STT_STORAGE_BACKEND=local

# Set STT_STORAGE_BACKEND=r2 when the API and worker do not share a disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=algorith-voice-audio

# Web (Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_STRIPE_PRICE_PRO=
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_GITHUB_REPO=algorithco/algorithvoice-app
GITHUB_TOKEN=

# Desktop updater
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
