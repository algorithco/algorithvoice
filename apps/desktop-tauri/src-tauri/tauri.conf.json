{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Algorith Voice",
  "version": "0.5.2",
  "identifier": "com.algorithvoice.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Algorith Voice",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "maximized": true,
        "backgroundColor": "#000000",
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc:; connect-src ipc: https://api.algorithvoice.com http://localhost:3001 https://github.com https://api.github.com https://objects.githubusercontent.com; img-src 'self' asset: blob: https://objects.githubusercontent.com; script-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {}
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["algorithvoice"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/algorithco/algorithvoice-app/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "RWTj1gBWRxhpWHQFrDiiL3Gs1KLt9asqUIznlF9rTAz2KLpZDLzylO/1"
    }
  }
}
