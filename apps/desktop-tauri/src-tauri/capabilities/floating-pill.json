{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "floating-pill-capability",
  "description": "Least privilege for the keyboard-driven dictation pill: mic capture + transcribe/paste only, plus read-only prefs so it mirrors Settings. No history, model management, updater, or tray.",
  "windows": ["floating-pill"],
  "permissions": [
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "store:allow-load",
    "store:allow-get",
    "allow-license-status",
    "allow-transcribe-audio",
    "allow-transcribe-and-paste",
    "allow-paste-text",
    "allow-get-foreground-info",
    "allow-ensure-floating-pill",
    "allow-set-floating-pill-visible",
    "allow-floating-pill-visible",
    "allow-set-floating-pill-expanded"
  ]
}
