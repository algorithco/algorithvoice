{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Full privileges for the main window only (tray, hotkeys, models, updater)",
  "windows": ["main"],
  "permissions": [
    "core:tray:default",
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "core:menu:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:allow-check",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "dialog:allow-message",
    "notification:allow-notify",
    "deep-link:allow-get-current",
    "allow-get-version",
    "allow-license-status",
    "allow-set-tray-state",
    "allow-get-tray-state",
    "allow-open-settings",
    "allow-store-session",
    "allow-session-status",
    "allow-revoke-and-clear-session",
    "allow-clear-session",
    "allow-get-hotkey",
    "allow-register-hotkey",
    "allow-unregister-hotkey",
    "allow-transcribe-audio",
    "allow-transcribe-and-paste",
    "allow-paste-text",
    "allow-set-groq-api-key",
    "allow-has-groq-key",
    "allow-clear-groq-key",
    "allow-get-foreground-info",
    "allow-ensure-floating-pill",
    "allow-set-floating-pill-visible",
    "allow-floating-pill-visible",
    "allow-set-floating-pill-expanded",
    "allow-history-save",
    "allow-history-list",
    "allow-history-stats",
    "allow-history-delete",
    "allow-history-clear",
    "allow-local-usage-summary",
    "allow-local-usage-clear",
    "allow-list-available-models",
    "allow-get-model-status",
    "allow-get-installed-models",
    "allow-download-model",
    "allow-cancel-download",
    "allow-delete-model",
    "allow-verify-model",
    "allow-select-active-model",
    "allow-start-inference-worker",
    "allow-stop-inference-worker",
    "allow-get-transcription-status",
    "allow-get-hardware-info",
    "allow-get-model-compatibilities",
    "allow-get-log-dir",
    "allow-read-recent-logs",
    "allow-log-frontend-error",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://api.trqsh.uz/*" },
        { "url": "https://app.trqsh.uz/*" }
      ]
    }
  ]
}
