{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-capability",
  "description": "Settings window: prefs + account + hotkey + model manager + update check. Shares store/autostart with main.",
  "windows": ["settings"],
  "permissions": [
    "core:window:default",
    "core:webview:default",
    "core:app:default",
    "core:event:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    "updater:allow-check",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "dialog:allow-message",
    "notification:allow-notify",
    "global-shortcut:allow-register",
    "global-shortcut:allow-is-registered",
    "global-shortcut:allow-unregister",
    "allow-get-version",
    "allow-license-status",
    "allow-store-session",
    "allow-session-status",
    "allow-revoke-and-clear-session",
    "allow-clear-session",
    "allow-get-hotkey",
    "allow-register-hotkey",
    "allow-unregister-hotkey",
    "allow-set-groq-api-key",
    "allow-has-groq-key",
    "allow-clear-groq-key",
    "allow-local-usage-summary",
    "allow-local-usage-clear",
    "allow-list-available-models",
    "allow-get-model-status",
    "allow-get-installed-models",
    "allow-download-model",
    "allow-cancel-download",
    "allow-delete-model",
    "allow-verify-model",
    "allow-select-active-model",
    "allow-start-inference-worker",
    "allow-stop-inference-worker",
    "allow-get-transcription-status",
    "allow-get-hardware-info",
    "allow-get-model-compatibilities",
    "allow-get-log-dir",
    "allow-read-recent-logs",
    "allow-log-frontend-error",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://api.trqsh.uz/*" },
        { "url": "https://app.trqsh.uz/*" }
      ]
    }
  ]
}
