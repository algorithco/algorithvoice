{
  "name": "@algorith-voice/backend",
  "version": "0.4.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/queues/worker.ts",
    "redis:wsl": "powershell -ExecutionPolicy Bypass -File scripts/redis-wsl.ps1",
    "start": "node dist/server.js",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "prisma generate --schema ../../infra/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema ../../infra/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema ../../infra/prisma/schema.prisma"
  },
  "dependencies": {
    "@algorith-voice/shared-types": "workspace:*",
    "@aws-sdk/client-s3": "^3.893.0",
    "@aws-sdk/s3-request-presigner": "^3.893.0",
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.2.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/oauth2": "^8.3.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/websocket": "^11.2.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.81.4",
    "fastify": "^5.12.3",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "ioredis": "^5.6.1",
    "pino": "^9.9.0",
    "stripe": "^22.6.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "22.0.0",
    "autocannon": "^8.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
