{
  "name": "@algorith-voice/web",
  "version": "0.4.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev -p 3000",
    "start": "next start",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "remotion:studio": "remotion studio remotion/index.ts --config remotion.config.ts",
    "remotion:render": "remotion render HowToUse out/howto-use.mp4 --config remotion.config.ts",
    "remotion:render:square": "remotion render HowToUseSquare out/howto-use-square.mp4 --config remotion.config.ts",
    "remotion:render:vertical": "remotion render HowToUseVertical out/howto-use-vertical.mp4 --config remotion.config.ts",
    "remotion:still": "remotion still HowToUse out/howto-use-still.jpeg --frame 30 --config remotion.config.ts"
  },
  "dependencies": {
    "@algorith-voice/shared-types": "workspace:*",
    "@algorith-voice/ui": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "5.2.5",
    "@fontsource/inter-tight": "5.2.5",
    "@fontsource/jetbrains-mono": "5.2.5",
    "@gsap/react": "^2.1.2",
    "@remotion/cli": "4",
    "@remotion/google-fonts": "^4.0.526",
    "@remotion/player": "4",
    "@tailwindcss/postcss": "4.3.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.46.0",
    "motion": "^13.3.0",
    "next": "^16.3.0",
    "ogl": "^1.0.11",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "^3.1.0",
    "remotion": "4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "tailwindcss": "^4.1.11",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
