generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  EMAIL
  GOOGLE
  GITHUB
}

enum SubStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum UsageMetric {
  STT_SECONDS
  AUDIO_BYTES
  WS_MINUTES
  STORAGE_BYTES
}

enum DeviceType {
  DESKTOP_MACOS
  DESKTOP_WINDOWS
  DESKTOP_LINUX
}

enum PlanTier {
  free
  pro
}

model User {
  id               String         @id @default(cuid())
  email            String         @unique
  passwordHash     String?
  name             String?
  stripeCustomerId String?        @unique
  planTier         PlanTier       @default(free)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  accounts         Account[]
  sessions         Session[]
  devices          Device[]
  subscriptions    Subscription[]
  usageRecords     UsageRecord[]
  audioAssets      AudioAsset[]
  providerKeys     ProviderKey[]
  auditLogs        AuditLog[]
}

model Account {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     AuthProvider
  providerId   String
  email        String?
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([provider, providerId])
  @@index([userId])
}

model Session {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshHash     String    @unique
  familyId        String
  deviceInfo      String?
  ip              String?
  expiresAt       DateTime
  absoluteLimitAt DateTime
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId, familyId])
  @@index([familyId])
  @@index([expiresAt])
}

model Device {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         DeviceType @default(DESKTOP_MACOS)
  fingerprint  String?
  apiKeyHash   String?    @unique
  lastSeenAt   DateTime?
  createdAt    DateTime   @default(now())

  @@index([userId])
  @@index([userId, fingerprint])
  @@index([userId, createdAt])
}

model Subscription {
  id                   String     @id @default(cuid())
  userId               String
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId String     @unique
  stripePriceId        String?
  status               SubStatus
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean    @default(false)
  usageRecords         UsageRecord[]
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
}

model UsageRecord {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  deviceId       String?
  metric         UsageMetric
  quantity       Decimal      @db.Decimal(12, 3)
  model          String?
  latencyMs      Int?
  stripeEventId  String?
  reportedToStripe Boolean    @default(false)
  metadata       Json?
  recordedAt     DateTime     @default(now())

  @@index([userId, metric, recordedAt])
  @@index([reportedToStripe, recordedAt])
  @@index([subscriptionId])
  @@index([deviceId])
}

model AudioAsset {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  r2Key          String   @unique
  bucket         String
  mime           String
  size           Int
  durationSec    Float?
  retentionUntil DateTime?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
  @@index([retentionUntil])
  @@index([userId, retentionUntil])
}

model ProviderKey {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  wrappedDek  String
  ciphertext  String
  nonce       String
  algorithm   String   @default("XChaCha20-Poly1305")
  kekVersion  Int      @default(1)
  last4       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  revokedAt   DateTime?

  @@unique([userId, provider])
  @@index([userId])
}

model StripeEvent {
  id          String   @id
  type        String
  payload     Json
  status      String   @default("received")
  attempts    Int      @default(0)
  lastError   String?
  processedAt DateTime @default(now())

  @@index([status, processedAt])
  @@index([type, processedAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  deviceId     String?
  action       String
  model        String?
  recordId     String?
  ipHash       String?
  userAgentHash String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([model, recordId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}
